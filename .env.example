# Chain (testnet only; the apps refuse to start on any other chain id)
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
EXPLORER_URL=https://sepolia.basescan.org
BLOCKSCOUT_API=https://base-sepolia.blockscout.com/api

# Keys (created by pnpm keys:generate; testnet only; never commit)
AGENT_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
OWNER_MODE=local
# Owner authentication for approvals: passkey (default) or dev (tests only)
OWNER_APPROVAL_AUTH=passkey

# Contracts
VAULT_ADDRESS=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
WETH_ADDRESS=0x4200000000000000000000000000000000000006
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# x402
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
ORACLE_URL=http://localhost:4020
API_PUBLIC_URL=http://localhost:4010
# Petty cash: largest single x402 payment and the float level that triggers a vault top-up (USDC)
X402_MAX_PAYMENT_USDC=0.01
PETTY_CASH_MIN_USDC=0.2
PETTY_CASH_TOPUP_USDC=0.5

# LLM (any OpenAI-compatible endpoint). Leave blank to use the deterministic MockPlanner.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
PLANNER=mock

# Policy
SANCTIONS_LIST_MAX_AGE_DAYS=7

# Persistence
DATABASE_PATH=./data/mandate.db

# Ports
API_PORT=4010
ORACLE_PORT=4020
WEB_PORT=3000
