packages/contracts/broadcast/*/31337/
packages/contracts/evidence/31337-*.json
packages/contracts/evidence/latest-31337.json

# next.js
apps/web/.next/
apps/web/next-env.d.ts
packages/contracts/deployments/identity-31337.json
packages/attacks/results/*31337*.json
packages/attacks/results/latest-31337.json

# submission build intermediates (the PDFs and zip are regenerated)
submission/svg/
submission/.*.md
submission/.pdf.css
submission/MANIFEST.md
