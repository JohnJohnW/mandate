{
  "name": "mandate",
  "version": "0.1.0",
  "private": true,
  "description": "A policy-bound autonomous on-chain wallet agent. The agent holds a mandate, not a key.",
  "author": "John Wynter",
  "contributors": [
    "John Wynter"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keys:generate": "tsx scripts/gen-keys.ts",
    "contracts:test": "pnpm --filter @mandate/contracts test",
    "contracts:deploy": "pnpm --filter @mandate/contracts deploy",
    "evidence:run": "pnpm --filter @mandate/contracts evidence",
    "attacks:run": "pnpm --filter @mandate/api attacks",
    "submission:build": "tsx scripts/build-submission.ts",
    "dev:api:anvil": "pnpm --filter @mandate/api dev:anvil",
    "dev:web": "pnpm --filter @mandate/web dev",
    "contracts:deploy:anvil": "pnpm --filter @mandate/contracts deploy:anvil",
    "evidence:anvil": "pnpm --filter @mandate/contracts evidence:anvil",
    "identity:register": "pnpm --filter @mandate/contracts identity",
    "identity:anvil": "pnpm --filter @mandate/contracts identity:anvil",
    "dev:oracle:anvil": "pnpm --filter @mandate/oracle dev:anvil",
    "attacks:anvil": "pnpm --filter @mandate/api attacks:anvil"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@marp-team/marp-cli": "4.5.1",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "md-to-pdf": "^5.2.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "viem": "^2.57.7",
    "vitest": "^5.0.5"
  }
}
